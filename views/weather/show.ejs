<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Weather in <%= city %></title>
</head>

<body>
    <h1>Name of the City:&nbsp;<%= city %></h1>
    <h3>Date:&nbsp;<%= currentDate %></h3>
    <h3>Current Local Time:&nbsp;<%= currentTime%></h3>
    <h3>Current Temperature: <%= temperature %> °F</h3>
    <h3>Current Weather Conditions: <%= description %></h3>
    <a href="/weather">Back to home!</a>
</body>

</html>